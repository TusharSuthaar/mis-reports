# Copy to .env (git-ignored) and adjust. Every value has a default in docker-compose.yml.

# First ADMIN, created only when the user table is empty. Password: 10+ characters, must not contain the username.
MIS_BOOTSTRAP_ADMIN_USERNAME=
MIS_BOOTSTRAP_ADMIN_PASSWORD=

# PAN encryption and lookup-hash keys (base64, 32 bytes each). Required. Generate each with:
#   openssl rand -base64 32
# Keep them safe and never change them once real PANs are stored: without the key the PANs cannot be read.
MIS_PAN_KEY=
MIS_PAN_HASH_KEY=

MIS_DB_USER=mis
MIS_DB_PASSWORD=mis

# Host ports
MIS_DB_PORT=5442
MIS_API_PORT=8090
MIS_UI_PORT=5180

# Set to true when served over HTTPS
MIS_COOKIE_SECURE=false
